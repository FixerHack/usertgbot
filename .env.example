# --- shared / db ---
# matches docker-compose.yml's postgres service — `docker compose up -d` first
DB_URL=postgresql+asyncpg://usertgbot:usertgbot@localhost:5432/usertgbot

# --- Telegram API (my.telegram.org), used by management_bot (/connect) and userbot ---
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash

# --- management_bot (main bot: subscription/connect/settings) ---
BOT_TOKEN=123456:your-bot-token-from-botfather

# --- manager_bot (personal notification bot) ---
# used by userbot workers (MANAGER_BOT_TOKEN optional there) and by `uv run manager-bot`
MANAGER_BOT_TOKEN=123456:your-manager-bot-token-from-botfather
# manager bot @username (no @) — shown to users so they can start it
MANAGER_BOT_USERNAME=personmanbot
# management bot @username (no @) — used by userbot workers to build the
# "re-link account" button on the session-expired notice. Without it the
# notice still arrives, just without the one-tap button.
MANAGEMENT_BOT_USERNAME=useagentperbot

# --- support/help ---
SUPPORT_CONTACT=@your_support

# --- admin panel (/admin in the management bot) ---
ADMIN_IDS=724233980           # comma-separated Telegram ids allowed to open the panel
NGROK_AUTHTOKEN=              # from https://dashboard.ngrok.com (empty = localhost only)
NGROK_DOMAIN=                 # optional: your free reserved static domain (dashboard.ngrok.com -> Domains) -
                               # keeps the Mini App URL stable across bot restarts instead of a new random one each time
ADMIN_PANEL_PORT=8080

# --- Mini App connect flow (browser-based login) ---
# A SEPARATE, PUBLIC api_id/api_hash pair from my.telegram.org — not
# TELEGRAM_API_ID/HASH above. This one gets served to the browser (part of
# the MTProto handshake GramJS performs), so it must be treated as public;
# TELEGRAM_API_ID/HASH stay private and are what the userbot workers use to
# hold sessions afterward. Burning this one only stops new logins.
# Leave both empty (the default) to keep /connect on the old in-chat keypad
# flow entirely — that's what keeps production untouched until these are set.
WEBAPP_API_ID=
WEBAPP_API_HASH=
CONNECT_WEB_PORT=8081          # locally reuses NGROK_AUTHTOKEN above for the public HTTPS tunnel
# PRODUCTION: the real HTTPS origin Caddy already terminates in front of us.
# Set it and no tunnel is opened at all (ngrok is only for local testing).
CONNECT_PUBLIC_URL=            # e.g. https://moozuku.tech
# Must be 0.0.0.0 in Docker so the published port is reachable from the host's
# reverse proxy; leave as loopback for local runs.
CONNECT_WEB_HOST=127.0.0.1

# --- payments ---
# Telegram Stars need no config (Bot API). Crypto Pay from @CryptoBot:
CRYPTO_PAY_TOKEN=             # empty = crypto option hidden; Stars still work
CRYPTO_PAY_TESTNET=false
CRYPTO_PAY_FIAT=USD

# WayForPay — bank cards in UAH, with gateway-driven auto-renewal.
# All three empty = the hryvnia option is hidden; Stars and crypto are
# unaffected. The payment pages are served on CONNECT_PUBLIC_URL above
# (https://<domain>/pay/...), so that domain must be reachable from the
# internet: WayForPay calls its serviceUrl server-to-server, and a payment
# that never gets confirmed is never activated.
#
# WAYFORPAY_DOMAIN must match the domain registered on the merchant in the
# WayForPay cabinet EXACTLY — it is covered by the purchase signature, and a
# mismatch is rejected at the gateway with no useful error.
#
# For testing before a real merchant is approved, the sandbox pair from the
# docs works end to end:
#   WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
#   WAYFORPAY_SECRET_KEY=flk3409refn54t54t*FNJRET
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
WAYFORPAY_DOMAIN=              # exactly the domain registered on the merchant
# A SEPARATE value from the secret key — the cabinet shows both under
# "Реквізити мерчанта". Signatures use the key; this one authenticates the
# regularApi call that cancels auto-renewal. Leave it empty and payments still
# work while cancellation fails, which is a bad half-working state.
WAYFORPAY_MERCHANT_PASSWORD=
# NOTE: the acquirer's fee lives in shared/pricing.py (WFP_FEE), not here —
# it is contractual (cabinet -> "Ліміти і комісії"), currently 2%. If the rate
# changes, update it there or every hryvnia sale nets less than promised.

# --- session encryption (management_bot writes, userbot reads) ---
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
